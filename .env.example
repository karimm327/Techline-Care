# Copier en .env.local (développement) ; en production, renseigner ces variables dans Render.

# Base PostgreSQL. Le schéma « techlinecare » est sélectionné via le paramètre options.
# Local :  postgres://utilisateur:motdepasse@localhost:5432/techlinecare?options=-c%20search_path%3Dtechlinecare
# Aiven :  postgres://avnadmin:MOTDEPASSE@HOTE.aivencloud.com:PORT/defaultdb?options=-c%20search_path%3Dtechlinecare
DATABASE_URL=

# Aiven uniquement : contenu du fichier ca.pem (onglet « Overview » du service, « CA certificate »).
# Sur une seule ligne, remplacer les retours à la ligne par \n ; dans Render, coller le texte tel quel.
DATABASE_CA_CERT=

# Secret de signature des sessions (longue chaîne aléatoire)
JWT_SECRET=

# Fuseau horaire de l'équipe (Render est en UTC)
TZ=Europe/Paris

# Dossier des pièces jointes (par défaut ./uploads). Sur Render : chemin d'un disque persistant.
UPLOAD_DIR=
